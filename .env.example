# ────────────────────────────────────────────────────────────────
# Akaryakıt Fiyat Uygulaması — Ortam Değişkenleri
# Bu dosyayı kopyalayıp ".env" olarak kaydedin:
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────

# ── CollectAPI (Opsiyonel ama önerilir) ─────────────────────────
# https://collectapi.com/tr/api/gasPrice/akaryakit-fiyatlari-api
# Ücretsiz plan: 100 istek/ay (yaklaşık 3 istek/gün)
# Ücretli planlar çok daha fazla istek hakkı verir.
#
COLLECT_API_KEY=

# ── Cache süresi ─────────────────────────────────────────────────
# Kaç saat sonra yeni fiyat çekilsin? (varsayılan: 6)
# Türkiye'de fiyatlar genellikle günde bir kez güncellenir.
#
CACHE_TTL_SAAT=6

# ── Flask ────────────────────────────────────────────────────────
FLASK_ENV=production
